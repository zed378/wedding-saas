.env
.env.*
!.env.example

# Local upload staging (never public-servable, never committed)
.staging/
tmp/

# Test and coverage output
coverage/
test-results/
playwright-report/
.vitest/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
