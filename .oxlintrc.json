{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "tmp/**",
    "security/semgrep-tests/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-string-starts-ends-with": "off"
  }
}
