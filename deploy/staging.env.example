# Staging environment. `P0-23`.
#
# Copy to `.env` at the repository root ON THE DEPLOY HOST and fill in real values:
#
#   cp deploy/staging.env.example .env
#
# `.env` is git-ignored and `scripts/check-secrets.mjs` blocks a commit containing
# anything credential-shaped. Every value below is REQUIRED -- the compose file uses
# `${VAR:?required}` so a missing one fails at `up` with the variable named, rather than
# starting a service that cannot work and failing on the first request that needed it.
#
# docs/DEVOPS/00 § Environment Separation: staging carries no production data and no live
# payment credentials. `backend/api/src/config/secret-rules.ts` enforces the second one
# at startup -- a live Midtrans key outside production exits 78.

# ---------------------------------------------------------------- environment
# Staging runs a production BUILD -- docs/DEVOPS/00 § Parity wants it as close to
# production as possible -- while being a non-production ENVIRONMENT: sandbox payment
# credentials and seeded dummy data. Two variables, because one cannot say both
# (ADR-043).
NODE_ENV=production
APP_ENV=staging

# ---------------------------------------------------------------- hostnames
# HTTPS, because secret-rules.ts rejects a non-HTTPS origin outside development. These
# are the names the browser will use once the tunnel is up; CORS is checked against them,
# so they must match what the user's address bar actually says.
APP_ORIGIN=https://app.vizunicum.my.id
PUBLIC_INVITE_ORIGIN=https://invitation.vizunicum.my.id
ADMIN_ORIGIN=https://admin.vizunicum.my.id

# ---------------------------------------------------------------- database
# Two roles, two URLs (backend/api/migrations/README.md). The owner can alter schema and
# bypasses row-level security; the application role cannot and must not have it. Only the
# `migrate` service receives MIGRATION_DATABASE_URL.
POSTGRES_DB=wedding
POSTGRES_OWNER_USER=wedding_owner
POSTGRES_OWNER_PASSWORD=changeme-owner-password
MIGRATION_DATABASE_URL=postgres://wedding_owner:changeme-owner-password@postgres:5432/wedding
DATABASE_URL=postgres://wedding_app:changeme-app-password@postgres:5432/wedding

# The application role is created by deploy/postgres/init/01-app-role.sql, which reads
# this. It must match the password in DATABASE_URL above.
APP_DB_PASSWORD=changeme-app-password

# ---------------------------------------------------------------- storage
# MinIO on staging, Cloudflare R2 in production (ADR-011). Every bucket is private.
STORAGE_ACCESS_KEY_ID=wedding_staging
STORAGE_SECRET_ACCESS_KEY=changeme-storage-secret

# ---------------------------------------------------------------- auth secrets
# Required since `P1-03`, at 32 characters minimum, in EVERY environment (ADR-047): a
# short HMAC key is brute-forceable offline wherever it runs, so there is no test
# exemption. The API exits 78 at startup without them.
#
# GENERATE THESE ON THE DEPLOY HOST and nowhere else:
#
#   echo "JWT_SIGNING_KEY=$(openssl rand -base64 48)"      >> .env
#   echo "REFRESH_TOKEN_PEPPER=$(openssl rand -base64 48)" >> .env
#
# Neither is rotatable for free. `deploy/SECRETS.md`: a new signing key signs every user
# out (survivable with a 15-minute dual-key window), and a new pepper invalidates every
# refresh token, which ends every session with no window that avoids it.
JWT_SIGNING_KEY=changeme-generate-with-openssl-rand-base64-48
REFRESH_TOKEN_PEPPER=changeme-generate-with-openssl-rand-base64-48

# ---------------------------------------------------------------- browser-facing API
# Where a VISITOR's browser will find the API -- not where the containers find it.
#
# `web-app` is a Next application and this is inlined into its BROWSER BUNDLE at build
# time, so it is a compose build argument rather than a runtime variable. Changing it
# means rebuilding the image, not restarting the container.
#
# It cannot be `http://api:3000/api/v1`: a compose service name resolves inside the
# network and means nothing in a browser. Until the tunnel routes `/api/*`, use the
# VPN-reachable host port; once it does, use the public origin.
#
#   through the tunnel   https://app.vizunicum.my.id/api/v1
#   over the VPN         http://10.1.200.13:18000/api/v1
API_PUBLIC_BASE_URL=https://app.vizunicum.my.id/api/v1

# ---------------------------------------------------------------- host ports
# This host is shared. 18000-18399 is a block nothing else on it uses; run
# `docker compose ls` before changing them.
STAGING_API_PORT=18000
STAGING_WEB_APP_PORT=18100
STAGING_PUBLIC_INVITE_PORT=18200
STAGING_ADMIN_PORT=18300

# ---------------------------------------------------------------- tunnel
# Only needed with `--profile tunnel`. Zero Trust -> Networks -> Tunnels -> Create a
# tunnel -> Docker, then copy the long `ey...` value out of the command it shows.
#
# A RUN token, not an API token: it lets one container join one tunnel and can do
# nothing else -- it cannot read DNS, create records, or touch the account.
CLOUDFLARE_TUNNEL_TOKEN=changeme-paste-the-tunnel-run-token
