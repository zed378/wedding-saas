{
  "name": "@wi/schema",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-timezone": {
      "types": "./dist/invitation/event-timezone.d.ts",
      "default": "./dist/invitation/event-timezone.js"
    },
    "./event-date": {
      "types": "./dist/invitation/event-date.d.ts",
      "default": "./dist/invitation/event-date.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
