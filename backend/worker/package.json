{
  "name": "@wi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@wi/logging": "workspace:*",
    "@wi/schema": "workspace:*",
    "@wi/storage": "workspace:*",
    "@wi/ui": "workspace:*",
    "bullmq": "^6.7.10",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "main": "dist/main.js"
}
