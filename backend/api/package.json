{
  "name": "@wi/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/infra/db/migrate.mts",
    "db:rollback": "node src/infra/db/rollback.mts",
    "db:seed": "node src/infra/db/seed.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"[P0-17] lint not wired yet\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@wi/logging": "workspace:*",
    "@wi/schema": "workspace:*",
    "@wi/storage": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  },
  "main": "dist/main.js"
}
