# Copy to .env and fill in. `.env` is git-ignored and must stay that way.
# Per-environment sources are documented in docs/DEVOPS/00-ENVIRONMENTS.md; which secret
# store holds each value per environment is decided in P0-18.
#
# Every variable here is validated at startup by apps/api/src/config/env.schema.ts.
# A missing or malformed value stops the service with exit code 78 (EX_CONFIG) and names
# every offending variable, rather than failing later on the request that needed it.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------- origins
# CORS allowlist. docs/SECURITY/08 forbids `*` on authenticated endpoints, so these are
# required and there is no permissive default to fall back to by accident.
# Production hostnames are in docs/PLAN/10 § Hostnames.
APP_ORIGIN=http://localhost:3001
PUBLIC_INVITE_ORIGIN=http://localhost:3002
ADMIN_ORIGIN=http://localhost:3003

# ---------------------------------------------------------------- limits
# Largest accepted JSON body. Uploads do not travel this path — they are multipart and
# capped at the edge before the body is read (P1-17).
BODY_LIMIT=256kb

# How long in-flight requests are given to finish on shutdown before the process exits
# anyway. A bound, not a target: a deploy that hangs is worse than one that drops a request.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- reserved
# Added by the task named beside each one. Listed here so that an absent variable reads as
# "not built yet" rather than "someone forgot".
#
# DATABASE_URL=              # P0-06  postgres://user:pass@localhost:5432/wedding
# REDIS_URL=                 # P0-15  redis://localhost:6379
# STORAGE_ENDPOINT=          # P0-16  MinIO locally, Cloudflare R2 in production
# STORAGE_ACCESS_KEY_ID=     # P0-16
# STORAGE_SECRET_ACCESS_KEY= # P0-16
# JWT_SIGNING_KEY=           # P1-03
# REFRESH_TOKEN_PEPPER=      # P1-03
# MIDTRANS_SERVER_KEY=       # P3-03
# MIDTRANS_WEBHOOK_SECRET=   # P3-05
# RESEND_API_KEY=            # P4-06
