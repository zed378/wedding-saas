# Copy to .env and fill in. `.env` is git-ignored and must stay that way.
# Per-environment sources are documented in docs/DEVOPS/00-ENVIRONMENTS.md; which secret
# store holds each value per environment is decided in P0-18.
#
# Every variable here is validated at startup by apps/api/src/config/env.schema.ts.
# A missing or malformed value stops the service with exit code 78 (EX_CONFIG) and names
# every offending variable, rather than failing later on the request that needed it.

# ---------------------------------------------------------------- runtime
# The BUILD mode: development, test or production. Node, React and every bundler read
# it, so it has exactly three legal values.
NODE_ENV=development

# The DEPLOYMENT environment: development, test, staging or production
# (docs/DEVOPS/00 § Environment List). Separate from NODE_ENV because staging runs a
# production BUILD while being a non-production ENVIRONMENT -- see ADR-043.
# Defaults to NODE_ENV when unset, which is why development needs no value here.
# APP_ENV=development

PORT=3000

# ---------------------------------------------------------------- origins
# CORS allowlist. docs/SECURITY/08 forbids `*` on authenticated endpoints, so these are
# required and there is no permissive default to fall back to by accident.
# Production hostnames are in docs/PLAN/10 § Hostnames.
#
# The ports match the `dev` script of each surface (P0-22), which is the only thing that
# makes these useful defaults: an origin that does not match where the app actually
# listens produces a CORS failure in the browser and nothing at all in the API log.
APP_ORIGIN=http://localhost:3100
PUBLIC_INVITE_ORIGIN=http://localhost:3200
ADMIN_ORIGIN=http://localhost:3300

# ---------------------------------------------------------------- limits
# Largest accepted JSON body. Uploads do not travel this path — they are multipart and
# capped at the edge before the body is read (P1-17).
BODY_LIMIT=256kb

# How long in-flight requests are given to finish on shutdown before the process exits
# anyway. A bound, not a target: a deploy that hangs is worse than one that drops a request.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- local stack (P0-05)
# Host ports only; container ports are fixed. Override when something already holds one —
# a hardcoded host port turns "6379 is taken" into "the stack will not start".
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# CLAMAV_PORT=3310
# API_PORT=3000

# ---------------------------------------------------------------- logging (P0-12)
# Read directly by the logger rather than through the validated config, because it must
# exist before the DI container does -- the most important line it ever writes is a
# failure during startup. A bad value here changes a label or a format; redaction is not
# configurable and is unaffected.
# SERVICE_NAME=api          # appears as `service` on every line
# LOG_LEVEL=debug           # debug outside production, info in it
# LOG_PRETTY=false          # force JSON locally, as production emits it

# ---------------------------------------------------------------- database (P0-06)
# Two URLs, two roles, and the split is load-bearing.
#
# The application connects as wedding_app: it does not own its tables and holds neither
# SUPERUSER nor BYPASSRLS, so the row-level policies added later cannot be bypassed by
# the connection that serves requests (deploy/postgres/init/01-app-role.sql).
#
# Migrations connect as wedding_owner because they must create and alter those tables.
# Giving the application that URL would hand every request the privileges of a migration.
DATABASE_URL=postgres://wedding_app:wedding_app_dev@localhost:5432/wedding
MIGRATION_DATABASE_URL=postgres://wedding_owner:wedding_owner_dev@localhost:5432/wedding

# ---------------------------------------------------------------- storage (P0-16)
# MinIO locally, Cloudflare R2 in production (ADR-011). All three buckets are PRIVATE:
# reads go through the CDN with origin access control, never a bucket URL
# (docs/ARCHITECTURE/05 § Access Control). `staging` holds uploads that have passed only
# the cheap checks and have NOT been malware-scanned (docs/BACKEND/04 Stage 1 step 5).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minio_dev
STORAGE_SECRET_ACCESS_KEY=minio_dev_password
# STORAGE_BUCKET_USER_MEDIA=user-media
# STORAGE_BUCKET_TEMPLATE_ASSETS=template-assets
# STORAGE_BUCKET_STAGING=staging

# ---------------------------------------------------------------- reserved
# Added by the task named beside each one. Listed here so that an absent variable reads as
# "not built yet" rather than "someone forgot".
#
# ---------------------------------------------------------------- queue (P0-15)
# Cache, rate limiting and the job queue share one Redis (ADR-009).
REDIS_URL=redis://localhost:6379

# Which pool a worker process serves. Required, no default -- a worker that guessed
# would either leave media unprocessed or run every cron job three times.
# WORKER_POOL=general        # general | media | cron
# (moved to the storage section above)
# Required. At least 32 characters, in every environment -- a short HMAC key is
# brute-forceable offline from a single captured token.
#   openssl rand -base64 48
# The values below are placeholders and are REFUSED in production (secret-rules.ts).
# REFRESH_TOKEN_PEPPER cannot be rotated without signing every user out: see deploy/SECRETS.md.
JWT_SIGNING_KEY=changeme-dev-jwt-signing-key-not-a-real-secret
REFRESH_TOKEN_PEPPER=changeme-dev-refresh-pepper-not-a-real-secret
# MIDTRANS_SERVER_KEY=       # P3-03
# MIDTRANS_WEBHOOK_SECRET=   # P3-05
# RESEND_API_KEY=            # P4-06
