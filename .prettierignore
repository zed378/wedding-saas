# Helm templates are Go templates that happen to end in .yaml. They are not valid
# YAML until Helm renders them -- `{{- if ... }}` on line 1 makes prettier fail with
# "Block collections are not allowed within flow collections", which points at
# nothing. `helm lint` is the tool that checks these; deploy/helm/verify.sh runs it.
deploy/helm/*/templates/

# drizzle-kit writes these: the journal and one snapshot per migration. Formatting them
# means the next `db:generate` reintroduces a format failure, every time.
backend/api/migrations/meta/
