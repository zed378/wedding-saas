{
  "name": "wedding-invitation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:id-endpoints": "node scripts/check-id-endpoint-tests.mjs",
    "check:public-routes": "node scripts/check-public-route-reservations.mjs",
    "check:tenant-scope": "node scripts/check-tenant-scope.mjs",
    "check:status-writes": "node scripts/check-status-writes.mjs",
    "check:storage-paths": "node scripts/check-storage-paths.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:sast": "node scripts/check-sast.mjs",
    "check:migrations": "node scripts/check-migration-pairs.mjs && node scripts/check-destructive-migration.mjs",
    "db:roundtrip": "bash scripts/db-roundtrip.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
